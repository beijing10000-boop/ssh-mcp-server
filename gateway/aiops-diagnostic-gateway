#!/bin/sh
# Root-owned optional forced-command entry point. No arbitrary arguments/eval.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
LC_ALL=C
export LC_ALL
unset ENV BASH_ENV CDPATH
umask 077
[ "$#" -eq 0 ] || exit 64
request=${SSH_ORIGINAL_COMMAND-}
case "$request" in *'
'*|*'
'*|'') exit 64;; esac
set -f
IFS=' '
set -- $request
[ "$#" -ge 3 ] && [ "$#" -le 4 ] || exit 64
[ "$1" = aiops-v1 ] || exit 64
action=$2
window=$3
unit=${4-}
case "$window" in ''|*[!0-9]*) exit 64;; esac
[ "${#window}" -le 3 ] && [ "$window" -ge 1 ] && [ "$window" -le 120 ] || exit 64
case "$action" in
 directory)
   [ "$#" -eq 4 ] && [ "${#unit}" -le 200 ] || exit 64
   case "$unit" in *[!A-Za-z0-9_./-]*|*/../*|*/..) exit 64;; esac
   case "$unit" in /data|/data/*|/var/log|/var/log/*|/var/lib|/var/lib/*|/opt|/opt/*) ;; *) exit 64;; esac;;
 service|logs)
   [ "$#" -eq 4 ] && [ "${#unit}" -le 64 ] || exit 64
   case "$unit" in [A-Za-z0-9_]*) ;; *) exit 64;; esac
   case "$unit" in *[!A-Za-z0-9_.@-]*) exit 64;; esac;;
 *) [ "$#" -eq 3 ] || exit 64;;
esac
case "$action" in
 connection) cmd="printf 'AIOPS_SSH_OK\\n'; id -u; uname -s";;
 cpu) cmd="cat /proc/loadavg /proc/stat; if command -v vmstat >/dev/null 2>&1; then vmstat 1 2; else printf 'CAPABILITY_MISSING:vmstat\\n'; fi";;
 memory) cmd="cat /proc/meminfo; if command -v free >/dev/null 2>&1; then free -k; else printf 'CAPABILITY_MISSING:free\\n'; fi";;
 processes) cmd='ps -eo pid,ppid,comm,pcpu,pmem,rss,etime,state --sort=-pcpu | head -n 25';;
 memory_processes) cmd='ps -eo pid,ppid,comm,pcpu,pmem,rss,etime,state --sort=-rss | head -n 25';;
 directory) cmd='if command -v du >/dev/null 2>&1 && command -v nice >/dev/null 2>&1; then timeout -k 1 3 nice -n 19 du -x -s -- "$1"; else printf "CAPABILITY_MISSING:bounded-directory-check\n"; fi';;
 disk) cmd='df -Pk -l; df -Pi -l; head -n 80 /proc/mounts';;
 io) cmd="if command -v iostat >/dev/null 2>&1; then iostat -dx 1 2; else printf 'CAPABILITY_MISSING:iostat; cumulative counters only\\n'; cat /proc/diskstats; fi";;
 network) cmd="cat /proc/net/dev /proc/net/snmp; if command -v ip >/dev/null 2>&1; then ip -s link; ip route show; else printf 'CAPABILITY_MISSING:ip\\n'; cat /proc/net/route; fi";;
 sockets) cmd="if command -v ss >/dev/null 2>&1; then ss -s; ss -lnt | head -n 60; else printf 'CAPABILITY_MISSING:ss\\n'; head -n 60 /proc/net/tcp /proc/net/tcp6; fi";;
 system) cmd="date -u '+%Y-%m-%dT%H:%M:%SZ'; uname -sr; cat /proc/uptime /proc/loadavg; who -b";;
 service) cmd='if command -v systemctl >/dev/null 2>&1; then systemctl show --no-pager --property=Id,ActiveState,SubState,Result,MainPID,ExecMainStatus,ActiveEnterTimestamp -- "$1"; else printf "CAPABILITY_MISSING:systemctl\n"; fi';;
 logs) cmd='if command -v journalctl >/dev/null 2>&1; then journalctl --no-pager -q -u "$1" --since "-$2 min" -n 120 -o short-iso; else printf "CAPABILITY_MISSING:journalctl\n"; fi';;
 kernel) cmd='if command -v journalctl >/dev/null 2>&1; then journalctl --no-pager -q -k --since "-$2 min" -p warning -n 100 -o short-iso; else printf "CAPABILITY_MISSING:bounded-kernel-log\n"; fi';;
 health) cmd='printf '"'"'\n[负载与运行时长]\n'"'"'; cat /proc/loadavg /proc/uptime; printf '"'"'\n[内存 KiB]\n'"'"'; awk '"'"'/^(MemTotal|MemAvailable|SwapTotal|SwapFree):/{print}'"'"' /proc/meminfo; printf '"'"'\n[文件系统]\n'"'"'; df -Pk -l; printf '"'"'\n[inode]\n'"'"'; df -Pi -l; printf '"'"'\n[高 CPU 进程]\n'"'"'; ps -eo pid,comm,pcpu,pmem --sort=-pcpu | head -n 11';;
 capabilities) cmd='printf '"'"'[当前账号 UID]\n'"'"'; id -u; printf '"'"'[系统]\n'"'"'; uname -sr; printf '"'"'[采集命令]\n'"'"'; for tool in vmstat iostat free df du nice timeout ss ip systemctl journalctl docker podman; do if command -v "$tool" >/dev/null 2>&1; then printf '"'"'%s available\n'"'"' "$tool"; else printf '"'"'%s unavailable\n'"'"' "$tool"; fi; done';;
 failed_services) cmd='if ! command -v systemctl >/dev/null 2>&1; then printf '"'"'CAPABILITY_MISSING:systemctl\n'"'"'; exit 69; fi; rows=$(systemctl --failed --type=service --no-pager --plain --no-legend); status=$?; printf '"'"'%s\n'"'"' "$rows" | head -n 60; exit "$status"';;
 containers) cmd='if ! command -v timeout >/dev/null 2>&1; then printf '"'"'CAPABILITY_MISSING:timeout\n'"'"'; exit 69; fi; if command -v docker >/dev/null 2>&1; then rows=$(timeout -k 1 8 docker ps -a --format '"'"'{{.ID}}\t{{.Names}}\t{{.Image}}\t{{.Status}}'"'"'); status=$?; elif command -v podman >/dev/null 2>&1; then rows=$(timeout -k 1 8 podman ps -a --format '"'"'{{.ID}}\t{{.Names}}\t{{.Image}}\t{{.Status}}'"'"'); status=$?; else printf '"'"'CAPABILITY_MISSING:docker-or-podman\n'"'"'; exit 69; fi; printf '"'"'%s\n'"'"' "$rows" | head -n 60; exit "$status"';;
 *) exit 64;;
esac
printf 'AIOPS_GATEWAY_V1\n'
command -v timeout >/dev/null 2>&1 || { printf 'CAPABILITY_MISSING:timeout\n'; exit 69; }
# Only a string selected by the fixed case above reaches sh -c; unit/window are positional data.
exec timeout -k 1 12 /bin/sh -c "$cmd" aiops-fixed-action "$unit" "$window"
